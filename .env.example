# Used by docker-compose.yml only. Copy to .env (next to docker-compose.yml). Never commit .env.
# For running WITHOUT Docker, use backend/.env.example instead.

# Password for the PostgreSQL container (letters and numbers only, it goes into a URL)
POSTGRES_PASSWORD=changeThisPassword123

# 32+ characters. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173
# Where the browser finds the API (baked into the frontend image when it is built)
VITE_API_URL=http://localhost:8000/api
CAMPUS_COUNSELLOR_CONTACT=Campus Counselling Centre, Room 101, +91-00000-00000
NLP_ENABLED=true
