# Copy this file to .env and fill in real values. Never commit .env.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/mental_health_db
# Separate database used only by pytest (its tables are dropped after each test run)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/mental_health_test_db

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Campus counsellor contact shown to students who may be in crisis
CAMPUS_COUNSELLOR_CONTACT=Campus Counselling Centre, Room 101, +91-00000-00000

# AI chat: load the sentiment/emotion models at startup (first start downloads ~800 MB)
NLP_ENABLED=true

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
